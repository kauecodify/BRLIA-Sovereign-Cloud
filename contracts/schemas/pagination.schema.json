{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brlia.cloud/schemas/pagination.schema.json",
  "title": "BRLIA Paginacao",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1
    },
    "total_pages": {
      "type": "integer",
      "minimum": 0
    }
  }
}
