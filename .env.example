# BRLIA Sovereign Cloud - Environment Variables
# Copie este arquivo para .env e ajuste os valores conforme necessario

# Server Configuration
SERVER_PORT=8080
SERVER_MODE=release
SERVER_SHUTDOWN_TIMEOUT=30s

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=brlia
DB_PASSWORD=secure-password
DB_NAME=brlia_control
DB_SSL_MODE=disable
DB_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication Configuration
AUTH_ENABLED=true
JWT_SECRET=brlia-sovereign-cloud-secret-change-me
JWT_EXPIRY=15m
REFRESH_SECRET=brlia-refresh-secret-change-me
REFRESH_EXPIRY=168h
JWT_ISSUER=brlia-control-api

# Waterfall Configuration
WORKER_COUNT=10
QUEUE_WORKER_COUNT=5
SCHEDULER_INTERVAL=1s
CAPACITY_CHECK_INTERVAL=5s
FAILURE_CHECK_INTERVAL=10s
COST_OPTIMIZER_INTERVAL=30s
MAX_RETRIES=3
RETRY_DELAY=1s
ENABLE_AI=false
AI_CHECK_INTERVAL=1m

# Docker Configuration
DOCKER_REGISTRY=ghcr.io/kauecodify
DOCKER_TAG=latest

# Monitoring Configuration
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# External Services
NATS_URL=nats://localhost:4222
KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_REALM=brlia
KEYCLOAK_CLIENT_ID=brlia-control-api
KEYCLOAK_CLIENT_SECRET=client-secret
VAULT_URL=http://localhost:8200
VAULT_TOKEN=brlia-dev-token

# Network Configuration
NETWORK_CIDR=172.20.0.0/16
API_GATEWAY=http://localhost:8080

# Storage Configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=brlia

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
